{
  "Urls": "http://0.0.0.0:5000",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Lounge": {
    "DatabasePath": "data/lounge.db",
    "RetentionDays": 7,
    "MaxConnections": 1000,
    "MaxConnectionsPerIp": 100,
    "MutedSessions": [],
    "BannedSessions": [],
    "AdminKey": ""
  },
  "DataDragon": {
    "CacheDuration": "06:00:00",
    "RequestTimeout": "00:00:05",
    "FailureCooldown": "00:00:30",
    "MaxFailureCooldown": "00:05:00",
    "MaxResponseBytes": 65536
  }
}
