<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../build/OcrDependencies.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Sdcb.SimdPaddleOCR" Version="$(SimdPaddleOcrVersion)" />
    <PackageReference Include="Sdcb.SimdPaddleOCR.Models.ChineseV6Tiny" Version="$(SimdPaddleOcrModelsVersion)" />
    <PackageReference Include="Sdcb.SimdPaddleOCR.Models.ChineseV6Small" Version="$(SimdPaddleOcrModelsVersion)" />
    <Compile Include="../../LOL-GameAssistant/Domain/GameData/AugmentNameMatcher.cs" Link="AugmentNameMatcher.cs" />
    <Compile Include="../../LOL-GameAssistant/Infrastructure/GameData/AugmentImageRecognizer.cs" Link="AugmentImageRecognizer.cs" />
    <Compile Include="../../LOL-GameAssistant/Infrastructure/GameData/AugmentOcrEngine.cs" Link="AugmentOcrEngine.cs" />
    <Compile Include="../../LOL-GameAssistant/Application/GameData/IAugmentScanner.cs" Link="IAugmentScanner.cs" />
  </ItemGroup>
</Project>
